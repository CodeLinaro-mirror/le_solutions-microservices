###############################################
# Stage 1: Builder
###############################################
FROM ubuntu:24.04 AS genai-llm-vlm-service-builder

# Enable multiarch support so arm64 packages can be installed alongside amd64
RUN dpkg --add-architecture arm64

# Adjust apt sources lists for x86 packages
RUN sed -i 's|http://ports.ubuntu.com/ubuntu-ports/|http://archive.ubuntu.com/ubuntu/|'            \
        /etc/apt/sources.list.d/ubuntu.sources                                                  && \
    sed -i '/^Types: deb$/a Architectures: amd64' /etc/apt/sources.list.d/ubuntu.sources        && \
    sed -i '0,/http:\/\/archive.ubuntu.com\/ubuntu\//s|http://archive.ubuntu.com/ubuntu/|http://security.ubuntu.com/ubuntu/|' \
        /etc/apt/sources.list.d/ubuntu.sources

# Duplicate for arm64 and Adjust apt sources lists for arm packages
RUN cp /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list.d/arm64.sources             && \
    sed -i '/^Architectures:/d' /etc/apt/sources.list.d/arm64.sources                           && \
    sed -i '/^Types: deb$/a Architectures: arm64' /etc/apt/sources.list.d/arm64.sources         && \
    sed -i 's|http://archive.ubuntu.com/ubuntu/|http://ports.ubuntu.com/ubuntu-ports/|g'           \
        /etc/apt/sources.list.d/arm64.sources                                                   && \
    sed -i 's|http://security.ubuntu.com/ubuntu/|http://ports.ubuntu.com/ubuntu-ports/|g'          \
         /etc/apt/sources.list.d/arm64.sources

# Install ALL build dependencies in one layer:
# - cross-compilation tools (needed for fastrpc and the chatcompletions build)
# - fastrpc build deps (autoconf/automake/libtool/libbsd-dev/libyaml-dev)
# - QAIRT download tools (wget/unzip)
# - Python and image-processing dev libs
RUN apt-get update                                                                              && \
    apt-get install -y --no-install-recommends                                                     \
        build-essential ca-certificates                                                            \
        gcc-aarch64-linux-gnu g++-aarch64-linux-gnu libjsoncpp-dev:arm64 pkg-config                \
        cmake android-tools-adb                                                                    \
        git wget unzip libtool libbsd-dev libmd-dev libyaml-dev m4 autoconf automake               \
        python3 python3-pip python3-venv python3-dev                                               \
        libffi-dev libjpeg-dev libpng-dev libwebp-dev                                           && \
    apt-get clean                                                                               && \
    rm -rf /var/lib/apt/lists/*

# Build and install fastrpc (sets MACHINE_NAME_PATH to /run/device-model)
RUN git clone --depth 1 https://github.com/quic/fastrpc.git \
&& cd fastrpc \
&& autoreconf -is \
&& CFLAGS='-UMACHINE_NAME_PATH -DMACHINE_NAME_PATH=\"/run/device-model\"' ./configure --prefix=/usr --libdir=/usr/lib \
&& make -j"$(nproc)" \
&& make install \
&& rm -rf /fastrpc

# Add needed environment variables
ENV TARGET_SYSROOT="/"
ENV CHATCOMPLETIONS_BUILD_DIR="/mnt/work/build"
ENV CHATCOMPLETIONS_DEPLOY_DIR="/mnt/work/deploy"
ENV CHATCOMPLETIONS_DOWNLOAD_DIR="/mnt/work/downloads"
ENV CHATCOMPLETIONS_SRC_DIR="/mnt/work/src"
ENV CHATCOMPLETIONS_SCRIPTS_DIR="/mnt/work/scripts"
ENV CHATCOMPLETIONS_ADSP_DIR=${CHATCOMPLETIONS_DEPLOY_DIR}/usr/lib/rfsa/adsp
# qnp-sdk: fetch and copy the needed headers and libraries
ENV CHATCOMPLETIONS_QNP_DIR=2.46.0.260424
ENV CHATCOMPLETIONS_QNN_LIB_PATH=${CHATCOMPLETIONS_DOWNLOAD_DIR}/qairt/${CHATCOMPLETIONS_QNP_DIR}/lib
ENV CHATCOMPLETIONS_QNP_SDK=v${CHATCOMPLETIONS_QNP_DIR}.zip

RUN mkdir -p ${CHATCOMPLETIONS_BUILD_DIR} ${CHATCOMPLETIONS_DEPLOY_DIR}/usr/include ${CHATCOMPLETIONS_DEPLOY_DIR}/usr/lib
RUN wget -t 2 -T 30 -P ${CHATCOMPLETIONS_DOWNLOAD_DIR}                                             \
        https://softwarecenter.qualcomm.com/api/download/software/sdks/Qualcomm_AI_Runtime_Community/All/${CHATCOMPLETIONS_QNP_DIR}/${CHATCOMPLETIONS_QNP_SDK} && \
    cd ${CHATCOMPLETIONS_DOWNLOAD_DIR}                                                          && \
    unzip ${CHATCOMPLETIONS_QNP_SDK}                                                            && \
    rm -f ${CHATCOMPLETIONS_QNP_SDK}                                                            && \
    find ${CHATCOMPLETIONS_QNN_LIB_PATH}/aarch64-oe-linux-gcc11.2/                                 \
        -type f -iname "*snpe*" -exec rm {} \;                                                  && \
    cp -r ${CHATCOMPLETIONS_DOWNLOAD_DIR}/qairt/${CHATCOMPLETIONS_QNP_DIR}/lib/aarch64-oe-linux-gcc11.2/libGenie.so \
        /usr/lib/                                                                               && \
    cp -r ${CHATCOMPLETIONS_DOWNLOAD_DIR}/qairt/${CHATCOMPLETIONS_QNP_DIR}/include/Genie/*         \
        /usr/include/                                                                          && \
    cp -r ${CHATCOMPLETIONS_DOWNLOAD_DIR}/qairt/${CHATCOMPLETIONS_QNP_DIR}/include/Genie/*         \
        ${CHATCOMPLETIONS_DEPLOY_DIR}/usr/include/                                             && \
    mkdir -p ${CHATCOMPLETIONS_ADSP_DIR}                                                        && \
    cp ${CHATCOMPLETIONS_QNN_LIB_PATH}/hexagon-v68/unsigned/* ${CHATCOMPLETIONS_ADSP_DIR}/      && \
    cp ${CHATCOMPLETIONS_QNN_LIB_PATH}/hexagon-v73/unsigned/* ${CHATCOMPLETIONS_ADSP_DIR}/      && \
    cp ${CHATCOMPLETIONS_QNN_LIB_PATH}/hexagon-v75/unsigned/* ${CHATCOMPLETIONS_ADSP_DIR}/      && \
    cp ${CHATCOMPLETIONS_QNN_LIB_PATH}/aarch64-oe-linux-gcc11.2/libGenie.so                        \
        ${CHATCOMPLETIONS_DEPLOY_DIR}/usr/lib/                                                  && \
    cp ${CHATCOMPLETIONS_QNN_LIB_PATH}/aarch64-oe-linux-gcc11.2/*                                  \
        ${CHATCOMPLETIONS_DEPLOY_DIR}/usr/lib/                                                  && \
    rm -rf ${CHATCOMPLETIONS_DOWNLOAD_DIR}/qairt

# Create python virtual environment
RUN python3 -m venv /mnt/work/venv
ENV PATH="/mnt/work/venv/bin:$PATH"
RUN pip install --upgrade pip

# Copy web-api source code
COPY setup.cfg ${CHATCOMPLETIONS_SRC_DIR}/setup.cfg
COPY pyproject.toml ${CHATCOMPLETIONS_SRC_DIR}/pyproject.toml
COPY web-api ${CHATCOMPLETIONS_SRC_DIR}/web-api

# Install web-api server as python package (all dependencies declared in setup.cfg)
RUN pip install ${CHATCOMPLETIONS_SRC_DIR}

# Copy helper scripts
COPY scripts ${CHATCOMPLETIONS_SCRIPTS_DIR}

# Copy genai-lib source code
COPY genai-lib ${CHATCOMPLETIONS_SRC_DIR}/genai-lib

# Add bash aliases file
COPY .bash_aliases /root/.bash_aliases

# Build the chatcompletions project
RUN bash -c "source ${CHATCOMPLETIONS_SCRIPTS_DIR}/setup.sh && chatcompletions-build"

# Collect ALL runtime artifacts into /mnt/work/deploy so the runtime stage
# only needs a single COPY --from source directory
RUN cp /usr/lib/libcdsprpc.so* ${CHATCOMPLETIONS_DEPLOY_DIR}/usr/lib/                          && \
    cp /usr/lib/libadsprpc.so* ${CHATCOMPLETIONS_DEPLOY_DIR}/usr/lib/                          && \
    cp ${CHATCOMPLETIONS_SRC_DIR}/web-api/openapi_server/impl/genie_wrapper/include/genai_interface.h \
        ${CHATCOMPLETIONS_DEPLOY_DIR}/usr/include/                                              && \
    mkdir -p ${CHATCOMPLETIONS_DEPLOY_DIR}/iot-user/app/site-packages                          && \
    cp ${CHATCOMPLETIONS_SRC_DIR}/web-api/openapi_server/openapi.yaml                              \
        ${CHATCOMPLETIONS_DEPLOY_DIR}/iot-user/app/site-packages/                              && \
    cp ${CHATCOMPLETIONS_SRC_DIR}/web-api/openapi_server/configs/models_config.json                \
        ${CHATCOMPLETIONS_DEPLOY_DIR}/iot-user/app/site-packages/                              && \
    cp ${CHATCOMPLETIONS_SRC_DIR}/web-api/openapi_server/impl/genie_wrapper/vlm_standalone_test.py \
        ${CHATCOMPLETIONS_DEPLOY_DIR}/iot-user/app/site-packages/                              && \
    cp ${CHATCOMPLETIONS_SRC_DIR}/web-api/openapi_server/configs/sampler.json                      \
        ${CHATCOMPLETIONS_DEPLOY_DIR}/iot-user/app/site-packages/                              && \
    mkdir -p ${CHATCOMPLETIONS_DEPLOY_DIR}/mnt/work                                            && \
    cp -r /mnt/work/venv ${CHATCOMPLETIONS_DEPLOY_DIR}/mnt/work/venv

#########################
# Stage 2: Runtime Stage
#########################
FROM ubuntu:24.04 AS genai-llm-vlm-service

# Install all runtime dependencies in a single layer:
# Python runtime, JSON/image libs, and fastrpc runtime libs (libyaml-0-2, libbsd0)
RUN apt-get update                                                                              && \
    apt-get install -y --no-install-recommends                                                     \
        python3                                                                                    \
        libjsoncpp25 libatomic1                                                                    \
        libjpeg8 libpng16-16 libwebp7                                                              \
        libyaml-0-2 libbsd0 libmd0                                                              && \
    apt-get clean                                                                               && \
    rm -rf /var/lib/apt/lists/* /var/tmp/*

# Bake fastrpc DSP path config for all supported devices into a safe path
# that is never bind-mounted. The entrypoint copies it to
# /usr/share/qcom/conf.d/ at runtime after the bind-mount is in place.
RUN mkdir -p /etc/fastrpc                                                                       && \
    {                                                                                              \
      echo '# SPDX-License-Identifier: MIT';                                                      \
      echo '# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.';               \
      echo 'machines:';                                                                            \
      echo '  Qualcomm Technologies, Inc. Monaco Monza addons:';                                  \
      echo '    DSP_LIBRARY_PATH: qcs8300/Qualcomm/QCS8300-RIDE/dsp';                             \
      echo '  Qualcomm Technologies, Inc. Addons IQ 9075 EVK:';                                   \
      echo '    DSP_LIBRARY_PATH: sa8775p/Qualcomm/SA8775P-RIDE/dsp';                               \
      echo '  Qualcomm Technologies, Inc. IQ8 8275 Pro SKU EVK:';                                 \
      echo '    DSP_LIBRARY_PATH: qcs8300/Qualcomm/QCS8300-RIDE/dsp';                             \
    } > /etc/fastrpc/hexagon-dsp-binaries.yaml

# Create directory structure for application and make it world-accessible
# Setting HOME to /tmp prevents KeyError: getpwuid() when running as arbitrary unnamed UID
ENV HOME=/tmp

RUN mkdir -p /iot-user/app/site-packages                                                       && \
    chmod -R 777 /iot-user

# Copy all runtime artifacts from the builder deploy directory:
#   /usr/lib/     - libGenie.so, QNN aarch64 libs, libcdsprpc.so*, libadsprpc.so*,
#                   libllmservice.so, libvlmservice.so, and all other built libs
#   /usr/include/ - Genie headers, genai_interface.h
#   /opt/qcom/adsp - Hexagon DSP skel blobs (v68 / v73 / v75 unsigned)
COPY --from=genai-llm-vlm-service-builder /mnt/work/deploy/usr /usr
COPY --from=genai-llm-vlm-service-builder /mnt/work/deploy/mnt/work/venv /mnt/work/venv
COPY --from=genai-llm-vlm-service-builder /mnt/work/deploy/iot-user/app/site-packages /iot-user/app/site-packages

# FastRPC searches ADSP_LIBRARY_PATH for Hexagon skel .so files on the ARM side
ENV ADSP_LIBRARY_PATH=/usr/lib/rfsa/adsp

ENV PATH=/mnt/work/venv/bin:$PATH

# create symlink of libvlmservice library
RUN ln -s /usr/lib/libvlmservice.so /iot-user/app/site-packages/libvlmservice.so
# create symlink of libllmservice library
RUN ln -s /usr/lib/libllmservice.so /iot-user/app/site-packages/libllmservice.so

ENV VLM_LIBRARY_PATH=/iot-user/app/site-packages/libvlmservice.so
ENV LLM_LIBRARY_PATH=/iot-user/app/site-packages/libllmservice.so
ENV GENAI_INTERFACE_FILE=/usr/include/genai_interface.h

ENV VLM_SITE_PACKAGES_PATH=/iot-user/app/site-packages/

# Copy the Python entrypoint
COPY entrypoint.py /entrypoint.py

WORKDIR /mnt/work/models

ENTRYPOINT ["python3", "/entrypoint.py"]
