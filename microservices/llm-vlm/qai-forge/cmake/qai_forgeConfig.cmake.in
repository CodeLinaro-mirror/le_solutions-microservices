# ─────────────────────────────────────────────────────────────────────────────
# qai_forgeConfig.cmake.in
#
# CMake package config template for qai-forge.
# Generated by configure_package_config_file() in qai-forge/CMakeLists.txt.
#
# After installation, downstream projects use:
#   find_package(qai_forge REQUIRED)
#   target_link_libraries(my_target PRIVATE qai_forge::qai_forge)
# ─────────────────────────────────────────────────────────────────────────────

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# qai_forge requires nlohmann_json
find_dependency(nlohmann_json REQUIRED)

# qai_forge requires Threads (for std::mutex, std::condition_variable)
find_dependency(Threads REQUIRED)

# Import the exported targets (qai_forge::qai_forge, etc.)
include("${CMAKE_CURRENT_LIST_DIR}/qai_forgeTargets.cmake")

check_required_components(qai_forge)
