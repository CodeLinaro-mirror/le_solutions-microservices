# -----------------------------------------------------------------------------
# Twelve-Factor App Centralized Production Configuration
# -----------------------------------------------------------------------------

# -- Server Database & Platform settings
VECTOR_STORE_PORT=9005
VECTOR_STORE_PG_CONN=postgresql://postgres:postgres@localhost:5432/vectordb
VECTOR_STORE_PG_POOL_SIZE=10
VECTOR_STORE_MIGRATIONS_DIR=./server/migrations

# -- On-device Embedding Sidecar settings
EMBEDDING_SERVICE_URL=http://localhost:9090
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_SERVICE_TIMEOUT_MS=10000
EMBEDDING_CIRCUIT_BREAKER_THRESHOLD=5
EMBEDDING_CIRCUIT_BREAKER_COOLDOWN_S=30

# -- Platform job scheduler settings
VECTOR_STORE_INGEST_BATCH_SIZE=32
VECTOR_STORE_INGEST_WORKERS=2

# -- Client Runtime settings
VECTOR_STORE_URL=http://localhost:9005
VECTOR_STORE_EMBEDDING_PORT=9090
VECTOR_STORE_PROFILING_ENABLED=true
VECTOR_STORE_STORE_ID=vs_cpp_automated_test
