# It indicates the path of directory where client certificates are placed on host machine
CERTIFICATES_DIR=/local/mnt/workspace/certs

# It indicates the path of directory where configuration file (config.json) is placed on host machine
CONFIG_DIR=/local/mnt/workspace/dev-iot-solutions/micro-service/cloud-connect/config

# It indicates the platform architecture. Currently the supported value is linux/arm64 only.
TARGET_ARCH=linux/arm64

# Path of host machine where code coverage of IT testcases will be placed. 
IT_COVERAGE_DIR=/local/mnt/workspace/it_cov

# Path of host machine where code coverage of Unit testcases will be placed. 
UT_COVERAGE_DIR=/local/mnt/workspace/ut_cov

# Path of host machine where test report of Unit Testcases will be placed. 
UT_REPORTS_DIR=/local/mnt/workspace/ut_report

# The supported values for this environment variable is debug and release, you can set it as per your requirement.
BUILD_TYPE="release"

# If you are building the Cloud Connect MQTT microservice locally then you can provide image name and version using this environment variable,
# e.g. cloud-connect-mqtt:1.0.1. If you want to use image uploaded on docker repository then you can set the docker repository path to this varibale,
# e.g. docker-registry.qualcomm.com/advtechiotsolutions/release/c-ccm:1.0.4 
MQTT_IMAGE=cloud-connect-mqtt:1.0.1

# If you are building the Cloud Connect KAFKA microservice locally then you can provide image name and version using this environment variable,
# e.g. cloud-connect-kafka:1.0.1. If you want to use image uploaded on docker repository then you can set the docker repository path to this varibale,
# e.g. docker-registry.qualcomm.com/advtechiotsolutions/release/c-cck:1.0.4
KAFKA_IMAGE=cloud-connect-kafka:1.0.1

# Set the host name or IP of your machine where the redis server is deployed.
REDIS_HOST="127.0.0.1"

# Set the port on which the redis server is running.
REDIS_PORT=6379

# Set the host or IP of machine where the MQTT/KAFKA broker is deployed.
BROKER_HOST="127.0.0.1"

# Set the port on which your MQTT/KAFKA brokers are running.
BROKER_PORT=8883
