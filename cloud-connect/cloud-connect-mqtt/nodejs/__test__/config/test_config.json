{
    "RedisConsumers": [
        {
            "source": [
                "detection:ppe:*"
            ],
            "dest": [
                "detection/ppe/mqtt/*"
            ]
        },
        {
            "source": [
                "detection:rz:*"
            ],
            "dest": [
                "detection/ppe/mqtt/rz/*"
            ]
        },
        {
            "source": [
                "detection:channel:1",
                "detection:channel:2"
            ],
            "dest": [
                "detection/channel/mqtt/1",
                "detection/channel/mqtt/2"
            ]
        }
    ],
    "log_level": "DEBUG",
    "msg_err_handling_bool": 1,
    "client_id_prefix": "test_default",
    "enable_ssl_connection": 1,
    "ssl_config": {
        "root_ca_file": "__test__/certificates/rootca.pem.crt",
        "client_cert_file": "__test__/certificates/certificate.pem.crt",
        "client_private_key_file": "__test__/certificates/private.pem.key",
        "domain_validation_enabled_bool": 0
    }
}