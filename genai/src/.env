# It indicates the path of directory where genie wrapper library is placed on host machine
GENAI_LIBS_DIR=/opt/data/genie_bundle/

# The target platform for which image needs to be build
TARGET_ARCH=linux/arm64

# The port on which service to be deployed
GENAI_PORT=8080

# The report directory for UT and code coverage etc
GENAI_REPORT_DIR=/etc/Jenkins/report

# Name of the Model to be used
GENAI_MODEL_NAME="LLAMA3_1_8B"
